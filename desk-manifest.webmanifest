{
  "name": "EBCA Receipt Desk",
  "short_name": "Receipt Desk",
  "description": "Turn payment receipts and bank statements into a vendor advance ledger.",
  "start_url": "./receipts.html",
  "scope": "./receipts.html",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fbf7f0",
  "theme_color": "#7a0f1e",
  "lang": "en-IN",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./receipts.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "receipt",
          "accept": [
            "image/*",
            "application/pdf"
          ]
        }
      ]
    }
  }
}